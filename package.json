{
  "author": "eniallator",
  "description": "Deep guarding package",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eniallator/Deep-Guards.git"
  },
  "bugs": {
    "url": "https://github.com/eniallator/Deep-Guards/issues"
  },
  "keywords": [
    "validation",
    "typescript",
    "guarding",
    "guards"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "name": "deep-guards",
  "type": "module",
  "types": "dist/index.d.ts",
  "homepage": "https://github.com/eniallator/Deep-Guards",
  "version": "1.4.0",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "build": "tsc",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "findissues": "pnpm typecheck && pnpm lint && pnpm format:check",
    "bump-and-release": "node scripts/bump-and-release.ts",
    "release": "node scripts/release.ts",
    "publint": "publint run",
    "attw": "attw --pack .",
    "check-output": "node scripts/check-output.ts",
    "prepublish": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm test && pnpm publint && pnpm check-output"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tar": "^7.5.22",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
