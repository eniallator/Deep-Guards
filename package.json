{
  "author": "eniallator",
  "description": "Deep guarding package",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eniallator/Deep-Guards.git"
  },
  "bugs": {
    "url": "https://github.com/eniallator/Deep-Guards/issues"
  },
  "keywords": [
    "validation",
    "typescript",
    "guarding",
    "guards"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "name": "deep-guards",
  "type": "module",
  "types": "dist/index.d.ts",
  "homepage": "https://github.com/eniallator/Deep-Guards",
  "version": "1.4.0",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "build": "tsc",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "findissues": "pnpm typecheck && pnpm lint && pnpm format:check",
    "bump-and-release": "node scripts/bump-and-release.mjs",
    "release": "node scripts/release.mjs",
    "publint": "publint run",
    "attw": "attw --pack .",
    "check-output": "node scripts/check-output.mjs",
    "prepublish": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm test && pnpm publint && pnpm check-output"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@vitest/coverage-v8": "5.0.3",
    "happy-dom": "^20.14.6",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "tar": "^7.5.22",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
